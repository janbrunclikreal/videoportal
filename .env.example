# ===== Server =====
PORT=8081
NODE_ENV=development

# ===== Databáze =====
# Cesta k SQLite souboru. Pro Postgres/MySQL se v budoucnu přidá DATABASE_URL.
DB_PATH=database/videoportal.db

# ===== Session / Cookies =====
SESSION_COOKIE_NAME=sessionId
SESSION_TTL_MS=604800000
# Tajný klíč pro podepisování cookie payloadu (v produkci povinně dlouhý, náhodný).
SESSION_SECRET=change-me-in-production-please

# ===== Storage (S3 / R2) =====
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=videoportal-videos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=

# Lokální fallback pro vývoj, když S3 není nakonfigurováno.
LOCAL_UPLOAD_DIR=uploads

# ===== Bezpečnost / Režim =====
# Když false, registrace z /register je zakázaná – jen admin může zakládat účty.
ALLOW_PUBLIC_REGISTRATION=true

# Aktuální verze podmínek (ToS), kterou musí autor odsouhlasit při uploadu.
CURRENT_TOS_VERSION=v1.0
